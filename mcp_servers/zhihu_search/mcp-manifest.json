{
  "name": "global_search",
  "displayName": "知乎全网搜索",
  "description": "知乎全网搜索，支持过滤和多内容库搜索，获取知乎全站热榜、文章、问答等内容",
  "version": "1.0.0",
  "author": "知乎开放平台",
  "icon": "🎓",
  "agentType": "local",
  "entryPoint": {
    "module": "mcp_servers.zhihu_search.agent",
    "class": "ZhihuSearchMCPService"
  },
  "capabilities": {
    "tools": [
      {
        "name": "global_search",
        "description": "知乎全网搜索，覆盖全站文章、问答、话题。参数 query 必填，count 可选。",
        "parameters": {
          "query": {
            "type": "string",
            "description": "搜索关键词，例如：人工智能发展趋势"
          },
          "count": {
            "type": "integer",
            "description": "返回结果条数，默认 5"
          }
        },
        "required": ["query"]
      },
      {
        "name": "zhihu_hot_list",
        "description": "获取知乎实时热榜，返回当前热度最高的内容",
        "parameters": {
          "count": {
            "type": "integer",
            "description": "返回热榜条数，默认 10"
          }
        },
        "required": []
      }
    ]
  },
  "dependencies": {
    "packages": ["requests"]
  },
  "permissions": ["network"],
  "auto_activate": false
}