/* ========================================
   莲心AI — 清新蓝主题
   ======================================== */

QWidget { color: #2C2C2C; font-family: "Microsoft YaHei UI"; }

QPushButton { background-color: #6C7BFF; color: #FFFFFF; border: none; border-radius: 6px; padding: 6px 16px; font-size: 13px; }
QPushButton:hover { background-color: #5A6AEE; }
QPushButton:pressed { background-color: #4A5ADE; }
QPushButton:disabled { background-color: #D0D0E0; color: #AAAAAA; }

QLineEdit, QTextEdit, QPlainTextEdit { background-color: #FFFFFF; color: #2C2C2C; border: 1px solid #D0D0E0; border-radius: 6px; padding: 6px 10px; selection-background-color: #6C7BFF; selection-color: #FFFFFF; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus { border: 1px solid #6C7BFF; }

QComboBox { background-color: #FFFFFF; color: #2C2C2C; border: 1px solid #D0D0E0; border-radius: 6px; padding: 5px 10px; }
QComboBox:hover { border: 1px solid #6C7BFF; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView { background-color: #FFFFFF; color: #2C2C2C; border: 1px solid #D0D0E0; selection-background-color: #6C7BFF; selection-color: #FFFFFF; outline: none; }

QCheckBox { color: #2C2C2C; spacing: 8px; }
QCheckBox::indicator { width: 18px; height: 18px; border: 2px solid #C0C0D0; border-radius: 4px; background-color: #FFFFFF; }
QCheckBox::indicator:checked { background-color: #6C7BFF; border-color: #6C7BFF; }

QRadioButton { color: #2C2C2C; spacing: 8px; }
QRadioButton::indicator { width: 18px; height: 18px; border: 2px solid #C0C0D0; border-radius: 10px; background-color: #FFFFFF; }
QRadioButton::indicator:checked { background-color: #6C7BFF; border-color: #6C7BFF; }

QSpinBox, QDoubleSpinBox { background-color: #FFFFFF; color: #2C2C2C; border: 1px solid #D0D0E0; border-radius: 6px; padding: 4px 8px; }
QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid #6C7BFF; }

QSlider::groove:horizontal { height: 6px; background: #E0E0E8; border-radius: 3px; }
QSlider::handle:horizontal { width: 16px; height: 16px; margin: -5px 0; background: #6C7BFF; border-radius: 8px; }
QSlider::sub-page:horizontal { background: #6C7BFF; border-radius: 3px; }

QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #C0C0D0; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #6C7BFF; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0; }
QScrollBar::handle:horizontal { background: #C0C0D0; border-radius: 4px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #6C7BFF; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QTabWidget::pane { border: 1px solid #D8D8E8; border-radius: 8px; background-color: #F0F2F7; top: -1px; }
QTabBar::tab { background-color: #E8E8F0; color: #666666; border: 1px solid #D8D8E8; border-bottom: none; border-radius: 8px 8px 0 0; padding: 8px 18px; margin-right: 2px; }
QTabBar::tab:selected { background-color: #F0F2F7; color: #6C7BFF; border-bottom: 2px solid #6C7BFF; }
QTabBar::tab:hover:!selected { color: #2C2C2C; background-color: #F8F8FC; }

QProgressBar { background-color: #E0E0E8; border: none; border-radius: 4px; height: 8px; text-align: center; color: transparent; }
QProgressBar::chunk { background-color: #6C7BFF; border-radius: 4px; }

QToolTip { background-color: #FFFFFF; color: #2C2C2C; border: 1px solid #D0D0E0; border-radius: 4px; padding: 4px 8px; }

QMenu { background-color: #FFFFFF; color: #2C2C2C; border: 1px solid #D0D0E0; border-radius: 6px; padding: 4px; }
QMenu::item { padding: 6px 24px; border-radius: 4px; }
QMenu::item:selected { background-color: #6C7BFF; color: #FFFFFF; }
QMenu::separator { height: 1px; background: #E0E0E8; margin: 4px 8px; }

QGroupBox { border: 1px solid #D8D8E8; border-radius: 8px; margin-top: 12px; padding-top: 16px; color: #2C2C2C; font-weight: bold; }
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 8px; }

QListWidget, QListView { background-color: #FFFFFF; color: #2C2C2C; border: 1px solid #D8D8E8; border-radius: 6px; outline: none; }
QListWidget::item, QListView::item { padding: 6px 10px; }
QListWidget::item:selected, QListView::item:selected { background-color: #6C7BFF; color: #FFFFFF; }
QListWidget::item:hover:!selected, QListView::item:hover:!selected { background-color: #F0F2F7; }

QTreeView { background-color: #FFFFFF; color: #2C2C2C; border: 1px solid #D8D8E8; border-radius: 6px; outline: none; }
QTreeView::item:selected { background-color: #6C7BFF; color: #FFFFFF; }
QTreeView::item:hover:!selected { background-color: #F0F2F7; }

QLabel { color: #2C2C2C; background: transparent; }
